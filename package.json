{
  "name": "cozy-companions",
  "version": "2.0.0",
  "description": "An original customizable pixel cat and puppy for the Windows desktop.",
  "main": "src/main.js",
  "author": "Gaurav Kumar Sharma",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node tests/smoke.js && node --check src/main.js && node --check src/preload.js && node --check src/pixel-pet.js && node --check src/renderer.js",
    "dist": "electron-builder --win nsis --publish never",
    "pack": "electron-builder --dir"
  },
  "dependencies": {
    "uiohook-napi": "1.5.5"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "in.wenonbont.cozycompanions",
    "productName": "Cozy Companions",
    "compression": "maximum",
    "electronLanguages": ["en-US"],
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/uiohook-napi/**"
    ],
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Cozy-Companions-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cozy Companions",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    }
  }
}
